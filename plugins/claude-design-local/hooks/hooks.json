{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__claude-design__(get_claude_design_prompt|create_support_js|list_files)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/cd-guard.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-design__write_files",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/cd-guard.mjs\""
          }
        ]
      }
    ]
  }
}

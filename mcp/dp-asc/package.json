{
  "name": "dp-asc",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server exposing the full App Store Connect API (OpenAPI-generated)",
  "type": "module",
  "bin": {
    "dp-asc": "./src/index.ts"
  },
  "scripts": {
    "generate": "bun run scripts/generate-tools.ts",
    "start": "bun run src/index.ts",
    "smoke": "bun run scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "live": "bun run scripts/live-check.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
